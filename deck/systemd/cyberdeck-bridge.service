[Unit]
Description=Cyberdeck LXMF bridge (uxn2 Reticulum device backend)
After=rnsd.service
Requires=rnsd.service

[Service]
User=deck
RuntimeDirectory=cyberdeck
RuntimeDirectoryMode=0750
Environment=CYBERDECK_DISK=/home/deck/deck
ExecStart=/opt/cyberdeck/venv/bin/cyberdeck-bridge --socket /run/cyberdeck/bridge.sock
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
