# Copy to deck/deck.env and edit. Read by deck/setup.sh.

# Linux user that owns the deck (uxn2, rnsd, bridge all run as this user).
DECK_USER=deck

# LXMF display name announced to other Reticulum users.
DISPLAY_NAME="cyberdeck"

# Serial port of the USB RNode. Use a stable /dev/serial/by-id/ path.
# Leave empty to let setup.sh pick it if exactly one USB serial device is present,
# or to configure the RNode interface disabled until you fill it in.
RNODE_PORT=

# LoRa radio parameters (US/Canada 915 MHz band defaults).
RNODE_FREQUENCY=914875000
RNODE_BANDWIDTH=125000
RNODE_TXPOWER=7
RNODE_SPREADINGFACTOR=8
RNODE_CODINGRATE=5
